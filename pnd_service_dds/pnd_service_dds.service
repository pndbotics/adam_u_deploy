[Unit]
Description=Pnd Services DDS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 不在此处设置 Environment=LD_LIBRARY_PATH：lib/ 与脚本里调用的 ip/ifconfig 混用曾导致
# 系统工具加载错误 .so 而崩溃；库路径仅由 service_run.sh 内对 pnd_service_dds 使用 sudo env 注入。
ExecStart=/etc/pndbotics/pnd_service_dds/service_run.sh
WorkingDirectory=/etc/pndbotics/pnd_service_dds
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
KillMode=mixed
KillSignal=SIGTERM
# 须大于 service_run.sh 中 PND_TERM_GRACE_SEC（默认 35s），否则 systemd 会先杀脚本，主进程收不到足够时间做 disableAllJoints
TimeoutStopSec=90
# 确保停止时发送信号给整个进程组
ExecStop=/bin/kill -TERM $MAINPID
ExecStopPost=/bin/sleep 1

[Install]
WantedBy=multi-user.target

